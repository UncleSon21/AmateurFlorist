# ═══════════════════════════════════════════════════════════════════
#  Amateur Florist — environment variables
#  Copy this file to .env and fill in real values. Do NOT commit .env.
# ═══════════════════════════════════════════════════════════════════

# ─── FRONTEND (Vite) ───────────────────────────────────────────────
# Required for shop, cart, product-details, checkout, order-confirmation.
# Read via import.meta.env.VITE_*. Public (anon) keys only — safe in browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
# Stripe publishable key — used by checkout.ts to mount Stripe Elements
# (Apple Pay / Google Pay / Link / Card on /checkout.html).
# pk_test_... for development, pk_live_... for production.
# Get from Stripe Dashboard → Developers → API keys.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...


# ═══════════════════════════════════════════════════════════════════
#  EDGE FUNCTION SECRETS  (set with: supabase secrets set KEY=value)
#  These are NOT used by Vite/the frontend — they only run in
#  supabase/functions/* on Supabase's edge runtime.
# ═══════════════════════════════════════════════════════════════════

# ─── Supabase server-side ─────────────────────────────────────────
# SERVICE_ROLE_KEY bypasses RLS. NEVER expose this in the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ─── Stripe ───────────────────────────────────────────────────────
# sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
# → click your endpoint → Signing secret. Required by stripe-webhook function.
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (transactional email) ─────────────────────────────────
# Get from https://resend.com → API Keys
RESEND_API_KEY=re_...
# Verified sender domain. Until you verify a domain, you can only use
# onboarding@resend.dev (test mode — only delivers to your Resend account email).
FROM_EMAIL=orders@amateurflorist.com.au
# Where order alerts and wedding enquiries are sent.
OWNER_EMAIL=hello@amateurflorist.com.au

# ─── Twilio (optional — SMS notifications) ────────────────────────
# If left blank, SMS is silently skipped. All four must be set to enable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=
